<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/page_padding"
        android:paddingTop="@dimen/space_xl"
        android:paddingRight="@dimen/page_padding"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/button_back"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/close_settings"
                android:src="@drawable/ic_arrow_back_24"
                style="@style/Shengdu.IconButton" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:text="@string/settings_title"
                style="@style/Shengdu.Title" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_section"
            android:background="@color/shengdu_border" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/settings_playback_title"
            style="@style/Shengdu.SectionTitle" />

        <Switch
            android:id="@+id/switch_mute_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:minHeight="@dimen/touch_target"
            android:text="@string/option_mute_device"
            android:textColor="@color/shengdu_text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/option_audio_quality"
            android:textColor="@color/shengdu_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_audio_quality_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:minHeight="@dimen/touch_target"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/space_m"
            android:paddingTop="@dimen/space_s"
            android:paddingRight="@dimen/space_m"
            android:paddingBottom="@dimen/space_s"
            android:background="@drawable/bg_surface"
            android:textColor="@color/shengdu_text_primary"
            android:textSize="14sp"
            android:drawableEnd="@drawable/ic_expand_more_24"
            android:drawableTint="@color/shengdu_text_secondary"
            android:clickable="true"
            android:focusable="true" />

        <RadioGroup
            android:id="@+id/audio_quality_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@drawable/bg_surface"
            android:layout_marginTop="1dp"
            android:paddingLeft="@dimen/space_s"
            android:paddingRight="@dimen/space_s">
            <RadioButton
                android:id="@+id/audio_quality_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/audio_quality_auto" />
            <RadioButton
                android:id="@+id/audio_quality_44"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/audio_quality_44" />
            <RadioButton
                android:id="@+id/audio_quality_48"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/audio_quality_48" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_section"
            android:background="@color/shengdu_border" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/settings_notification_title"
            style="@style/Shengdu.SectionTitle" />

        <Button
            android:id="@+id/button_notification_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/settings_notification_access_off"
            style="@style/Shengdu.Button.Secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_section"
            android:background="@color/shengdu_border" />

        <Button
            android:id="@+id/button_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_section"
            android:text="@string/about_title"
            style="@style/Shengdu.Button.Secondary" />
    </LinearLayout>
</ScrollView>
