<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/about_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/page_padding"
        android:paddingTop="@dimen/space_xl"
        android:paddingRight="@dimen/page_padding"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/button_about_back"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/about_back"
                android:src="@drawable/ic_arrow_back_24"
                style="@style/Shengdu.IconButton" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:text="@string/about_title"
                style="@style/Shengdu.Title" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_section"
            android:background="@color/shengdu_border" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/app_name"
            style="@style/Shengdu.Title" />

        <TextView
            android:id="@+id/text_about_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textColor="@color/shengdu_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/about_description"
            android:textColor="@color/shengdu_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button_check_updates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/about_check_updates"
            style="@style/Shengdu.Button.Primary" />

        <Button
            android:id="@+id/button_about_project"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/about_project"
            style="@style/Shengdu.Button.Secondary" />

        <Button
            android:id="@+id/button_about_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/about_privacy"
            style="@style/Shengdu.Button.Secondary" />

        <Button
            android:id="@+id/button_about_support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/about_support"
            android:visibility="gone"
            style="@style/Shengdu.Button.Secondary" />
    </LinearLayout>
</ScrollView>
